          "sensor.sigen_plant_total_discharged_energy_of_the_ess"
        ]
      },
      {
        "level": "inverter",
        "unique_id": "{entry}_{device}_inverter_ess_accumulated_discharge_energy",
        "default_entity_ids": [
          "sensor.sigen_inverter_total_discharge_energy"
        ]
      }
    ],
    "charged_energy": [
      {
        "level": "plant",
        "unique_id": "{entry}_{device}_plant_accumulated_battery_charge_energy",
        "default_entity_ids": [
          "sensor.sigen_plant_accumulated_battery_charge_energy",
          "sensor.sigen_plant_total_charged_energy_of_the_ess"
        ]
      },
      {
        "level": "inverter",
        "unique_id": "{entry}_{device}_inverter_ess_accumulated_charge_energy",
        "default_entity_ids": [
          "sensor.sigen_inverter_total_charge_energy"
        ]
      }
    ],
    "rated_capacity": [
      {
        "level": "plant",
        "unique_id": "{entry}_{device}_plant_ess_rated_energy_capacity",
        "default_entity_ids": [
          "sensor.sigen_plant_rated_energy_capacity"
        ]
      },
      {
        "level": "inverter",
        "unique_id": "{entry}_{device}_inverter_rated_battery_capacity",
        "default_entity_ids": [
          "sensor.sigen_inverter_rated_battery_capacity"
        ]
      }
    ],
    "soh": [
      {
        "level": "plant",
        "unique_id": "{entry}_{device}_plant_ess_soh",
        "default_entity_ids": [
          "sensor.sigen_plant_battery_state_of_health"
        ]
      },
      {
        "level": "inverter",
        "unique_id": "{entry}_{device}_inverter_ess_battery_soh",
        "default_entity_ids": [
          "sensor.sigen_inverter_battery_state_of_health"
        ]
      }
    ]
  },
