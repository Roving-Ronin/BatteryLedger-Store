{
  "schema_version": 1,
  "id": "sigen-local-modbus",
  "profile_version": 2,
  "name": "Sigenergy ESS (TypQxQ Local Modbus)",
  "integration": {
    "platform": "sigen",
    "url": "https://github.com/TypQxQ/Sigenergy-Local-Modbus"
  },
  "brands": [
    "Sigenergy"
  ],
  "roles": {
    "discharged_energy": [
      {
        "level": "plant",
        "unique_id": "{entry}_{device}_plant_accumulated_battery_discharge_energy",
